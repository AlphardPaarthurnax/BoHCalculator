<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.github.alphardpaarthurnax.bohcalculator.controller.AspectBrowserController">
    <padding>
        <Insets top="8" left="8" right="8" bottom="8"/>
    </padding>
    <top>
        <TextField fx:id="searchField" promptText="搜索..."
                   style="-fx-font-size: 14px;">
            <BorderPane.margin>
                <Insets bottom="8"/>
            </BorderPane.margin>
        </TextField>
    </top>
    <left>
        <ListView fx:id="elementList" prefWidth="220"
                  style="-fx-font-size: 13px;">
            <BorderPane.margin>
                <Insets right="8"/>
            </BorderPane.margin>
        </ListView>
    </left>
    <center>
        <VBox alignment="TOP_CENTER" spacing="12">
            <padding>
                <Insets top="16" left="16" right="16" bottom="16"/>
            </padding>
            <ImageView fx:id="elementImage" fitWidth="64" fitHeight="64"
                       preserveRatio="true"/>
            <Label fx:id="elementName"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"
                   wrapText="true"/>
            <Label fx:id="elementId"
                   style="-fx-font-size: 12px; -fx-text-fill: gray;"
                   wrapText="true"/>
            <Label fx:id="elementSource"
                   style="-fx-font-size: 12px; -fx-text-fill: gray;"
                   wrapText="true"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS" prefViewportWidth="500">
                <TextFlow fx:id="elementDescription"
                          lineSpacing="4"
                          style="-fx-font-size: 14px;"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
